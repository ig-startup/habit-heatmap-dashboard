POSTGRES_PASSWORD=habits
CORS_ORIGINS=*
WEB_PORT=5180

# Real GitHub contribution sync (leave both empty to fall back to mock data)
GITHUB_TOKEN=
GITHUB_LOGIN=

# Yandex Metrika visits sync (leave either empty to disable — no mock fallback)
# Token: OAuth token with read access, https://oauth.yandex.ru/authorize?response_type=token&client_id=<id>
# Counter ID: numeric id from the Metrika counter's URL/settings
YANDEX_METRIKA_TOKEN=
YANDEX_METRIKA_COUNTER_ID=

# Shared secret for local-agent ingest endpoints (/api/metrics/{obsidian,youtube}/ingest)
# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=

# local-agent config
BACKEND_URL=http://localhost:8000
OBSIDIAN_ARTICLES_PATH=
# Requires Full Disk Access for local-agent/.venv/bin/python3 (broad TCC grant) —
# leave false until you've reviewed the tradeoff, see local-agent/README.md
YOUTUBE_COLLECTOR_ENABLED=false
# Public Telegram channel username (no @), scraped from t.me/s/<channel> — no login needed.
# Leave empty to disable. For history older than ~20 posts, run backfill_telegram.py once.
TELEGRAM_CHANNEL=
