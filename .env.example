POSTGRES_PASSWORD=habits
CORS_ORIGINS=*
WEB_PORT=5180

# Real GitHub contribution sync (leave both empty to fall back to mock data)
GITHUB_TOKEN=
GITHUB_LOGIN=

# Shared secret for local-agent ingest endpoints (/api/metrics/{obsidian,youtube}/ingest)
# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=

# local-agent config
BACKEND_URL=http://localhost:8000
OBSIDIAN_ARTICLES_PATH=
# Requires Full Disk Access for local-agent/.venv/bin/python3 (broad TCC grant) —
# leave false until you've reviewed the tradeoff, see local-agent/README.md
YOUTUBE_COLLECTOR_ENABLED=false
